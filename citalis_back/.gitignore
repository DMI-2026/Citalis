# Variables de entorno y secretos: solo se versiona .env.example
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
# Cuentas de servicio de Firebase / Google Cloud
*-firebase-adminsdk-*.json
serviceAccount*.json
google-services.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
