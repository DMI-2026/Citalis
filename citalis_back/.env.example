# ---------------------------------------------------------------------------
# Citalis · backend · variables de entorno
#
#   cp .env.example .env      y rellenar los valores reales
#
# Es el ÚNICO .env del backend: lo leen el gateway, los 6 servicios y los scripts de
# Prisma (pnpm dev / pnpm db:*). Docker Compose también lo usa.
# NUNCA subir .env al repositorio (está en .gitignore). Aquí solo van valores de ejemplo.
# Rúbrica S3: cero secretos en el repo; la configuración se inyecta por entorno.
# ---------------------------------------------------------------------------

# ─── Base de datos · PostgreSQL ────────────────────────────────────────────
# UNA base compartida; cada servicio usa su propio schema (auth, negocios, agenda, clientes,
# descubrimiento, notificaciones) y Prisma lo resuelve solo. Si el proveedor exige TLS añade
# ?sslmode=require. Si la contraseña tiene caracteres especiales, codifícalos (URL-encode).
#
# Desarrollo local con Docker (pnpm db:up) — usa el puerto 5433 para no chocar con un Postgres local en 5432:
DATABASE_URL=postgresql://citalis:citalis_dev@localhost:5433/citalis
# Proveedor remoto (Supabase / Neon): usa la cadena de conexión DIRECTA (no la del pooler)
# para poder correr migraciones, p. ej.:
# DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/postgres?sslmode=require

# ─── Seguridad ─────────────────────────────────────────────────────────────
# Secreto de las rutas /internal/* y de la confianza gateway→servicios.
# En producción: mínimo 32 caracteres aleatorios (openssl rand -hex 32).
INTERNAL_API_TOKEN=dev_internal_token_change_me_before_production

# ─── Firebase Auth (control de acceso) ─────────────────────────────────────
# Project ID del proyecto Firebase de Citalis (Consola de Firebase → Configuración).
FIREBASE_PROJECT_ID=
# Opcional para solo VERIFICAR tokens. Obligatorio para revocar sesiones o enviar push (FCM).
# Valores del JSON de la cuenta de servicio; NUNCA subas ese JSON al repo.
# La clave privada va en una línea con los saltos como \n.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternativa: ruta (fuera del repo) al JSON de la cuenta de servicio.
# GOOGLE_APPLICATION_CREDENTIALS=
# Desarrollo sin proyecto real: emulador de Firebase Auth.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ─── Gateway ───────────────────────────────────────────────────────────────
# Orígenes permitidos por CORS (solo Flutter Web; la app móvil no usa CORS), separados por coma.
CORS_ORIGINS=http://localhost:8080,https://citalis.vercel.app
# Rate limiting por IP: ventana en segundos y peticiones permitidas.
THROTTLE_TTL=60
THROTTLE_LIMIT=200
# Cuántos proxies hay delante del gateway (Nginx/ALB que termina TLS). Déjalo vacío en local.
# TRUST_PROXY=1
# Vigencia (ms) del caché UID de Firebase → usuario interno.
USER_CACHE_TTL_MS=30000

# ─── URLs de los servicios (solo si NO corren en localhost con los puertos por defecto) ──
# AUTH_SERVICE_URL=http://localhost:3001
# NEGOCIOS_SERVICE_URL=http://localhost:3002
# AGENDA_SERVICE_URL=http://localhost:3003
# CLIENTES_SERVICE_URL=http://localhost:3004
# DESCUBRIMIENTO_SERVICE_URL=http://localhost:3005
# NOTIFICACIONES_SERVICE_URL=http://localhost:3006

# ─── API de terceros · geocodificación (descubrimiento-service, rúbrica F3) ─
# Se define cuando el equipo elija proveedor (ver docs/backend/guia-de-trabajo.md).
# GEOCODING_BASE_URL=
# GEOCODING_API_KEY=

# ─── Operación ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=log
# GET /<prefijo>/test en cada servicio. En producción déjalo en false.
ENABLE_TEST_ENDPOINTS=true
# Swagger (/docs). En producción déjalo en false (rúbrica S5).
SWAGGER_ENABLED=true
TZ=America/Mexico_City
