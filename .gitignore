# Monorepo-level ignores. Cada subproyecto tiene su propio .gitignore
# con las exclusiones específicas de su stack.

# macOS / editores
.DS_Store
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml

# Entornos y secretos (nunca deben subirse)
.env
.env.*
*.env
*.pem
*.key
*.p12
*.jks
*.keystore
secrets.json

# Vercel
.vercel/

# Archivos locales de Claude Code / herramientas de IA
.claude/

# Capturas y archivos temporales de trabajo local
screenshots/
tmp/
.cache/
*.local
*.log
*.swp
*.swo

# Generados de cada app (también en sus .gitignore propios)
node_modules/
build/
.dart_tool/
dist/
coverage/
.turbo/

# Llaves y firmas que nunca se suben
# (google-services.json, GoogleService-Info.plist y firebase_options.dart SÍ se versionan)
*-adminsdk-*.json
serviceAccount*.json
key.properties
